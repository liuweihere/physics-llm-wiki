---
import BaseLayout from './BaseLayout.astro';
import LessonProgress from '../components/LessonProgress.astro';

interface Resource {
  slot: 'visual-primer' | 'sandbox' | 'reading' | 'hook';
  kind: 'simulator' | 'video' | 'book' | 'audio';
  title: string;
  url?: string;
  provider?: string;
  language?: string;
  duration?: string;
}

interface Props {
  entry: {
    data: {
      id: string;
      title: string;
      summary?: string;
      core_question?: string;
      wiki_source?: string;
      stage: number;
      age_range: string;
      pillar: string;
      loop_depth: number;
      order: number;
      resources: Resource[];
    };
  };
}

const { entry } = Astro.props;
const pillarLabels: Record<string, string> = {
  motion: '运动与时空',
  fields: '相互作用与场',
  energy: '能量与账本',
  micro: '物质微观建筑',
};
const slotLabels = {
  'visual-primer': '视觉启蒙与精选视频',
  sandbox: '去实验场玩一玩',
  reading: '读一读',
  hook: '场景化导语',
};
const resourceIcon = {
  video: '▶',
  simulator: '⌁',
  book: '▤',
  audio: '◉',
};
const groupedResources = Object.entries(slotLabels)
  .map(([slot, label]) => ({ slot, label, resources: entry.data.resources.filter((resource) => resource.slot === slot) }))
  .filter((group) => group.resources.length > 0);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div class="lesson-detail-page">
    <header class="lesson-detail-header">
      <div class="lesson-detail-header-inner">
        <a class="lesson-back" href={`/stages/${entry.data.stage}/`} aria-label="返回阶段路线图">←</a>
        <div class="lesson-breadcrumb">
          <span>Stage {entry.data.stage} ({entry.data.age_range.replace('-', '–')}岁) · {entry.data.order}/26 讲</span>
          <span>/</span>
          <strong>{pillarLabels[entry.data.pillar] ?? entry.data.pillar}</strong>
        </div>
        <LessonProgress lessonId={entry.data.id} compact />
      </div>
    </header>

    <main class="lesson-detail-main">
      <section class="lesson-detail-title">
        <div class="lesson-detail-kicker">Loop {entry.data.loop_depth} · {pillarLabels[entry.data.pillar] ?? entry.data.pillar}</div>
        <h1>{entry.data.title}</h1>
        {entry.data.summary && <p>{entry.data.summary}</p>}
        {entry.data.core_question && <p class="lesson-core-question">核心问题：{entry.data.core_question}</p>}
        {entry.data.wiki_source && <a class="lesson-wiki-source" href={entry.data.wiki_source} target="_blank" rel="noreferrer noopener">Wiki source ↗</a>}
      </section>

      {groupedResources.length > 0 && <section class="lesson-resource-index" aria-label="本讲资源">
        {groupedResources.map((group) => (
          <div class="lesson-resource-group">
            <h2>{group.label}</h2>
            <div class="lesson-resource-grid">
              {group.resources.map((resource) => {
                const card = (
                  <span class="lesson-resource-card-inner">
                    <span class="lesson-resource-icon" aria-hidden="true">{resourceIcon[resource.kind]}</span>
                    <span class="lesson-resource-copy">
                      <strong>{resource.title}</strong>
                      <small>{resource.provider ?? (resource.kind === 'simulator' ? 'Interactive simulator' : resource.kind === 'video' ? 'External video' : 'Reading material')}{resource.duration ? ` · ${resource.duration}` : ''}</small>
                    </span>
                    {resource.url && <b aria-hidden="true">↗</b>}
                  </span>
                );
                return resource.url ? <a class="lesson-resource-card" href={resource.url} target="_blank" rel="noreferrer noopener">{card}</a> : <div class="lesson-resource-card">{card}</div>;
              })}
            </div>
          </div>
        ))}
      </section>}

      <article class="lesson-flow">
        <div class="lesson-flow-line" aria-hidden="true"></div>
        <div class="lesson-flow-content"><slot /></div>
      </article>
    </main>
  </div>
</BaseLayout>
