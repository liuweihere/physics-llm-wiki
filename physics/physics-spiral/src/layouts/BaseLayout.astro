---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '小星星物理学螺旋体系' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · 小星星物理学</title>
  </head>
  <body>
    <slot />
  </body>
</html>
