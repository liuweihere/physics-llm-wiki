---
interface Props { lessonId: string; }
const { lessonId } = Astro.props;
---

<div class="side-card" data-lesson-progress data-lesson-id={lessonId}>
  <h2>小星星的学习状态</h2>
  <p>进度只保存在这台设备上，不会上传到服务器。</p>
  <div class="progress-actions">
    <button class="progress-button" type="button" data-progress-action="exploring">开始探索</button>
    <button class="progress-button" type="button" data-progress-action="mastered">标记为已掌握</button>
  </div>
</div>

<script>
  const key = 'physics-spiral:progress:v1';
  const container = document.querySelector<HTMLElement>('[data-lesson-progress]');
  const currentLessonId = container?.dataset.lessonId ?? '';
  type Progress = { exploring: string[]; mastered: string[]; updatedAt?: string };
  const read = (): Progress => {
    try {
      const value = JSON.parse(localStorage.getItem(key) ?? '{}');
      return value?.profiles?.default ?? { exploring: [], mastered: [] };
    } catch {
      return { exploring: [], mastered: [] };
    }
  };
  const write = (progress: Progress) => {
    localStorage.setItem(key, JSON.stringify({ version: 1, activeProfile: 'default', profiles: { default: progress } }));
    window.dispatchEvent(new CustomEvent('physics-progress-changed'));
  };
  const refresh = () => {
    const progress = read();
    document.querySelectorAll<HTMLElement>('[data-lesson-progress] [data-progress-action]').forEach((button) => {
      const action = button.getAttribute('data-progress-action') as 'exploring' | 'mastered' | null;
      button.setAttribute('data-active', String(action ? progress[action].includes(currentLessonId) : false));
    });
  };
  document.querySelectorAll<HTMLElement>('[data-lesson-progress] [data-progress-action]').forEach((button) => {
    button.addEventListener('click', () => {
      const action = button.getAttribute('data-progress-action');
      const progress = read();
      progress.exploring = Array.isArray(progress.exploring) ? progress.exploring : [];
      progress.mastered = Array.isArray(progress.mastered) ? progress.mastered : [];
      if (action === 'mastered') {
        progress.mastered = [...new Set([...progress.mastered, currentLessonId])];
        progress.exploring = progress.exploring.filter((id: string) => id !== currentLessonId);
      } else {
        progress.exploring = [...new Set([...progress.exploring, currentLessonId])];
      }
      progress.updatedAt = new Date().toISOString();
      write(progress);
      refresh();
    });
  });
  window.addEventListener('physics-progress-changed', refresh);
  refresh();
</script>
