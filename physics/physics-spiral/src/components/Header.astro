---
interface Props {
  completedCount: number;
  currentStage?: number;
  ageRange?: string;
  trackProgress?: boolean;
  staticProgress?: string;
  showStageSwitcher?: boolean;
}

const { completedCount, currentStage = 2, ageRange = '7~8岁', trackProgress = true, staticProgress, showStageSwitcher = true } = Astro.props;
const stageOptions = [
  { stage: 1, label: '6~7岁启蒙', href: '/stages/1/' },
  { stage: 2, label: '7~8岁探索', href: '/stages/2/' },
];
---

<header class="site-header shell">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="返回物理螺旋首页">
      <span class="brand-mark" aria-hidden="true">🌟</span>
      <span>小星星的物理漫游</span>
    </a>
    <div class="header-right">
      {showStageSwitcher && <nav class="stage-switcher" aria-label="切换学习阶段">
        {stageOptions.map((option) => <a class:list={{ active: option.stage === currentStage }} href={option.href} aria-current={option.stage === currentStage ? 'page' : undefined}>Stage {option.stage}<span>{option.label}</span></a>)}
      </nav>}
      <div class="progress-copy" data-progress-summary data-track-progress={trackProgress}>
        <strong>Stage {currentStage} ({ageRange}) <span data-progress-text>{staticProgress ?? `· 已掌握 ${completedCount} 讲`}</span></strong>
      </div>
    </div>
  </div>
</header>

<script>
  const key = 'physics-spiral:progress:v1';
  const readProgress = () => {
    try {
      const value = JSON.parse(localStorage.getItem(key) ?? '{}');
      return Array.isArray(value?.profiles?.default?.mastered) ? value.profiles.default.mastered : [];
    } catch {
      return [];
    }
  };

  const update = () => {
    const summary = document.querySelector('[data-progress-summary][data-track-progress="true"]');
    if (!summary) return;
    const text = document.querySelector('[data-progress-text]');
    if (!text) return;
    text.textContent = `· 已掌握 ${readProgress().length} 讲`;
  };

  window.addEventListener('physics-progress-changed', update);
  update();
</script>
